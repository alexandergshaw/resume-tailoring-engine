    "selection_logic": {
      "score_formula": {
        "exact_buzzword_match": 5,
        "alias_match": 3,
        "job_title_match": 6,
        "required_skill_match": 8,
        "preferred_skill_match": 4,
        "resume_evidence_match": 6,
        "domain_match": 4,
        "protected_claim_conflict": -100
      },
      "minimum_score_to_activate_mapping": 10,
      "slot_assignment_rules": [
        "project1 (Mutual of Omaha) uses the highest-scoring technical/engineering mapping and the 'designed_and_implemented' bullet shape",
        "project2 and project3 (Metropolitan College) prefer mappings whose preferred_slots include project2/project3 (e.g. curriculum_design, education_instruction); if a posting is purely technical, the next-highest-scoring technical mappings may be used with the 'modernized' bullet shape",
        "do not assign the same mapping to more than one slot unless fewer than three mappings activate",
        "project names are assembled as: {{PROJECT_SCOPE}} (from shared_scope_terms) + {{PROJECT_TYPE}} + ': ' + {{PRIMARY_CAPABILITY}} + ' & ' + {{STRATEGIC_OUTCOME}}, all chosen from the assigned mapping's options"
      ],
      "bullet_fill_rules": {
        "source": "bullet_fragments from the mapping assigned to that slot, matching the slot's bullet_shape",
        "use_job_posting_alias_when_available": true,
        "fallback_to_canonical_name": true,
        "measurable_impact_must_be_plausible": true,
        "deduplicate_fragments": true,
        "one_fragment_per_placeholder": true
      },
      "prefer_posting_language_aliases": true
    }
