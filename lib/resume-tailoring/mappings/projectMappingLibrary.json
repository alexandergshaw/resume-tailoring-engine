      "name_components": "Word banks for the project-title slots: {{PROJECT_SCOPE}} {{PROJECT_TYPE}}: {{PRIMARY_CAPABILITY}} & {{STRATEGIC_OUTCOME}}.",
      "bullet_fragments": "Phrase banks keyed to each {{PLACEHOLDER}} used in the project bullets. The Mutual of Omaha project uses the 'designed_and_implemented' bullet shape; the two Metropolitan College projects use the 'modernized' bullet shape.",
      "mapping_priority": "How strongly this mapping should be emphasized when matching a posting.",
      "enabled_when": "Rules for deciding whether the mapping contributes to the project section."
    },
    "fixed_anchors": {
      "project_slots": [
        {
          "slot": "project1",
          "employer": "Mutual of Omaha",
          "bullet_shape": "designed_and_implemented",
          "bullet_template": "Designed and implemented {{PROJECT_SOLUTION}} using {{JOB_RELEVANT_TECHNOLOGIES}}, enabling {{NEW_CAPABILITY}} and delivering {{MEASURABLE_IMPACT}}."
        },
        {
          "slot": "project2",
          "employer": "Metropolitan College",
          "bullet_shape": "modernized",
          "bullet_template": "Modernized {{EXISTING_SYSTEM_OR_PROCESS}} through {{TECHNICAL_APPROACH}}, improving {{PERFORMANCE_OR_BUSINESS_METRIC}} by {{MEASURABLE_IMPACT}}."
