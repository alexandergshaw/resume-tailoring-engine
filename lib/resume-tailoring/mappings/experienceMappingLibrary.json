{
  "experience_section_mapping_library": {
    "version": "1.0",
    "purpose": "Map job posting buzzwords to deterministic resume job-title components (rank, specialization, function, areas of emphasis) and professional-experience bullet fragments for tailored resume generation. Employers, dates, and quantitative anchors (10,000+ users, 75,000+ daily events, team of 5) are fixed; only descriptive wording is selected from these mappings.",
    "experience_model": {
      "rank_terms": "Seniority words used for the {{Top Rank}}, {{Medium Rank}}, and {{Low Rank}} title slots. Top describes the most recent Mutual of Omaha role, Medium the prior Mutual of Omaha role, Low the Union Pacific role.",
      "title_components": "Word banks for the {{Specialization}}, {{Function}}, and {{Areas of Emphasis}} title slots.",
      "bullet_fragments": "Phrase banks keyed to each {{PLACEHOLDER}} that appears in the professional-experience bullets.",
      "mapping_priority": "How strongly this mapping should be emphasized when matching a posting.",
      "enabled_when": "Rules for deciding whether the mapping contributes to the experience section."
    },
    "fixed_anchors": {
      "employers_and_dates": [
        "Mutual of Omaha | July 2023 (Top Rank role)",
        "Metropolitan College | Mar 2023 (Adjunct Professor, fixed)",
        "Mutual of Omaha | May 2022 to July 2023 (Medium Rank role)",
        "Union Pacific | May 2019 to May 2022 (Low Rank role)"
      ],
      "protected_metrics": [
        "10,000+ internal users",
        "75,000+ daily operational events",
        "engineering team of 5 developers",
        "100+ students per term",
        "8+ project-based courses"
      ]
    },
    "protected_rules": {
      "never_insert_without_profile_evidence": [
        "programming languages",
        "frameworks",
        "cloud platforms",
        "databases",
        "security tools",
        "healthcare standards",
        "certifications",
        "specific employer-named systems"
      ],
      "allowed_to_generalize": [
        "technical leadership",
        "stakeholder communication",
        "requirements gathering",
        "troubleshooting",
        "documentation",
        "workflow improvement",
        "application modernization",
        "technical instruction",
        "systems analysis",
        "delivery coordination"
      ],
      "preserve_aliases_if_posting_uses_them": true,
      "rank_consistency": "job1 (Top) must outrank job2 (Medium) which must outrank job3 (Low)."
    },
    "shared_rank_terms": {
      "top": [
        "Senior",
        "Lead",
        "Principal",
        "Staff"
      ],
      "medium": [
        "Software",
        "Application",
        "Mid-Level",
        "Intermediate"
      ],
      "low": [
        "Associate",
        "Junior",
        "Entry-Level"
      ]
    },
